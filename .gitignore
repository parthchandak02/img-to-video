# Ignore output video files
*.mp4

# Ignore image files
*.jpg
*.jpeg
*.png
*.JPG
*.JPEG
*.PNG

# But keep the directory structure
!input/
!output/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
aienv/

# Distribution / packaging
dist/
build/
*.egg-info/

# OS specific files
.DS_Store
Thumbs.db

# Editor specific files
.vscode/
.idea/
*.swp
*.swo
